/* ===== VENTANA PRINCIPAL ===== */
QMainWindow {
    background-color: #ffffff;
}

/* ===== SIDEBAR ===== */
#Sidebar {
    background-color: #f5f5f5;
}

/* Botones del sidebar */
QPushButton#SidebarButton {
    background-color: #e8e8e8;
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    text-align: left;
    margin: 6px 8px;
}

QPushButton#SidebarButton:hover {
    background-color: #d5d5d5;
    padding-left: 12px;
}

QPushButton#SidebarButton:pressed {
    background-color: #c5c5c5;
}

/* ===== TÍTULOS ===== */
#TituloVista {
    font-size: 20px;
    font-weight: 700;
    color: #1a1a1a;
    background-color: transparent;
}

#TitleLabel {
    font-size: 24px;
    font-weight: 700;
    color: #1a1a1a;
    background-color: transparent;
    margin-bottom: 6px;
}

/* ===== TABLAS ===== */
QTableWidget {
    background-color: #ffffff;
    color: #1a1a1a;
    gridline-color: #d5d5d5;
    font-size: 14px;
    alternate-background-color: #f9f9f9;
}

QHeaderView::section {
    background-color: #d5d5d5;
    color: #1a1a1a;
    padding: 6px;
    border: none;
    font-size: 14px;
    font-weight: 600;
}

QTableWidget::item {
    padding: 6px 8px;
}

QTableWidget::item:selected {
    background-color: #b0b0b0;
    color: #1a1a1a;
}

/* ===== BOTONES DE ACCIÓN ===== */
QPushButton#ActionButton {
    min-height: 36px;
    min-width: 100px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    background-color: #d5d5d5;
    color: #1a1a1a;
}

QPushButton#ActionButton:hover {
    background-color: #c5c5c5;
}

QPushButton#ActionButton:pressed {
    background-color: #b0b0b0;
}

/* ===== BUSCADOR ===== */
QLineEdit#ActionSearch {
    min-height: 36px;
    min-width: 180px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 400;
    background-color: #f5f5f5;
    color: #1a1a1a;
    border: 1px solid #d5d5d5;
}

QLineEdit#ActionSearch:hover {
    background-color: #f0f0f0;
}

QLineEdit#ActionSearch:focus {
    background-color: #ffffff;
    border: 1px solid #999999;
}

/* ===== ESTILO GENERAL DE LINEEDIT ===== */
QLineEdit {
    background-color: #f5f5f5;
    color: #1a1a1a;
    border: 1px solid #d5d5d5;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #999999;
}

/* ===== WIDGETS CONTENEDOR ===== */
QWidget {
    background-color: #ffffff;
}

/* ===== COMBOBOX ===== */
QComboBox {
    background-color: #f5f5f5;
    color: #1a1a1a;
    border: 1px solid #d5d5d5;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 14px;
}

QComboBox:hover {
    background-color: #f0f0f0;
}

QComboBox::drop-down {
    border: none;
}

/* ===== SPINBOX ===== */
QSpinBox, QDoubleSpinBox {
    background-color: #f5f5f5;
    color: #1a1a1a;
    border: 1px solid #d5d5d5;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 14px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #999999;
}

/* ===== DIALOG Y POPUPS ===== */
QDialog {
    background-color: #ffffff;
}

QMessageBox {
    background-color: #ffffff;
}

/* ===== LABEL ===== */
QLabel {
    color: #1a1a1a;
    background-color: transparent;
}

/* ===== SCROLL BAR ===== */
QScrollBar:vertical {
    background-color: #ffffff;
    width: 10px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #cccccc;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #999999;
}

QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    border: none;
    background: none;
}

/* ===== CHECKBOX Y RADIO BUTTON ===== */
QCheckBox, QRadioButton {
    color: #1a1a1a;
    background-color: transparent;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #d5d5d5;
    border-radius: 4px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid #999999;
}

QCheckBox::indicator:checked {
    background-color: #999999;
    border: 1px solid #999999;
}