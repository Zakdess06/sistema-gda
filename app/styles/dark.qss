/* ===== SIDEBAR ===== */
#Sidebar {
    background-color: #1e1e1e;
}

/* Botones del sidebar */
QPushButton#SidebarButton {
    background-color: #2a2a2a;
    color: #ffffff;
    font-size: 38px;          
    font-weight: 850;         
    border: none;
    border-radius: 10px;
    padding: 14px 18px;
    text-align: left;
}


QPushButton#SidebarButton:hover {
    background-color: #353535;
}

QPushButton#SidebarButton:pressed {
    background-color: #3f3f3f;
}

/* ===== TÍTULOS ===== */
#TituloVista {
    font-size: 36px;          
    font-weight: 700;
    color: white;
}

#TitleLabel {
    font-size: 42px;          
    font-weight: 700;
    margin-bottom: 8px;
}

/* ===== TABLAS ===== */
QTableWidget {
    background-color: #1e1e1e;
    color: white;
    gridline-color: #333;
    font-size: 24px;
    alternate-background-color: #2a2a2a;
}

QHeaderView::section {
    background-color: #2a2a2a;
    color: white;
    padding: 10px;
    border: none;
    font-size: 24px;
    font-weight: 600;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #0094C2;
    color: white;
}

/* ===== BOTONES DE ACCIÓN ===== */
QPushButton#ActionButton {
    min-height: 42px;
    min-width: 110px;
    padding: 10px 18px;
    border-radius: 10px;
    font-size: 24px;
    font-weight: 600;
    background-color: #2d2d2d;
    color: white;
    transition: background-color 0.2s ease;
}

QPushButton#ActionButton:hover {
    background-color: #3a3a3a;
}

QPushButton#ActionButton:pressed {
    background-color: #1f1f1f;
}

/* ===== BUSCADOR ===== */
QLineEdit#ActionSearch {
    min-height: 42px;
    min-width: 220px;
    padding: 10px 18px;
    border-radius: 10px;
    font-size: 24px;
    font-weight: 600;
    background-color: #2a2a2a;
    color: white;
    border: 1px solid #3a3a3a;
    transition: background-color 0.2s ease, border 0.2s ease;
}

QLineEdit#ActionSearch:hover {
    background-color: #3a3a3a;
}

QLineEdit#ActionSearch:focus {
    background-color: #1f1f1f;
    border: 1px solid #0094C2;
}

/* ===== ESTILO GENERAL DE LINEEDIT ===== */
QLineEdit {
    background-color: #2a2a2a;
    color: white;
    border: 1px solid #3a3a3a;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 16px;
}

QLineEdit:focus {
    border: 1px solid #0094C2;
}
