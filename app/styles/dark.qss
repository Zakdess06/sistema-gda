/* ===== VENTANA PRINCIPAL ===== */
QMainWindow {
    background-color: #0f0f0f;
}

/* ===== SIDEBAR ===== */
#Sidebar {
    background-color: #1e1e1e;
}

/* Botones del sidebar */
QPushButton#SidebarButton {
    background-color: #2a2a2a;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    text-align: left;
    margin: 6px 8px;
}

QPushButton#SidebarButton:hover {
    background-color: #353535;
    padding-left: 26px;
}

QPushButton#SidebarButton:pressed {
    background-color: #3f3f3f;
}

/* ===== TÍTULOS ===== */
#TituloVista {
    font-size: 20px;
    font-weight: 700;
    color: #f1f5f9;
    background-color: transparent;
}

#TitleLabel {
    font-size: 24px;
    font-weight: 700;
    color: #f1f5f9;
    background-color: transparent;
    margin-bottom: 6px;
}

/* ===== TABLAS ===== */
QTableWidget {
    background-color: #1e1e1e;
    color: white;
    gridline-color: #333;
    font-size: 14px;
    alternate-background-color: #2a2a2a;
}

QHeaderView::section {
    background-color: #2a2a2a;
    color: white;
    padding: 6px;
    border: none;
    font-size: 14px;
    font-weight: 600;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #0094C2;
    color: white;
}

/* ===== BOTONES DE ACCIÓN ===== */
QPushButton#ActionButton {
    min-height: 36px;
    min-width: 100px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    background-color: #2d2d2d;
    color: white;
}

QPushButton#ActionButton:hover {
    background-color: #3a3a3a;
}

QPushButton#ActionButton:pressed {
    background-color: #1f1f1f;
}

/* ===== BUSCADOR ===== */
QLineEdit#ActionSearch {
    min-height: 36px;
    min-width: 180px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 400;
    background-color: #2a2a2a;
    color: white;
    border: 1px solid #3a3a3a;
}

QLineEdit#ActionSearch:hover {
    background-color: #3a3a3a;
}

QLineEdit#ActionSearch:focus {
    background-color: #1f1f1f;
    border: 1px solid #0094C2;
}

/* ===== ESTILO GENERAL DE LINEEDIT ===== */
QLineEdit {
    background-color: #2a2a2a;
    color: white;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #0094C2;
}

/* ===== WIDGETS CONTENEDOR ===== */
QWidget {
    background-color: #0f0f0f;
}

/* ===== COMBOBOX ===== */
QComboBox {
    background-color: #2a2a2a;
    color: white;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 14px;
}

QComboBox:hover {
    background-color: #3a3a3a;
}

QComboBox::drop-down {
    border: none;
}

/* ===== SPINBOX ===== */
QSpinBox, QDoubleSpinBox {
    background-color: #2a2a2a;
    color: white;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 14px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #0094C2;
}

/* ===== DIALOG Y POPUPS ===== */
QDialog {
    background-color: #0f0f0f;
}

QMessageBox {
    background-color: #0f0f0f;
}

/* ===== LABEL ===== */
QLabel {
    color: white;
    background-color: transparent;
}

/* ===== SCROLL BAR ===== */
QScrollBar:vertical {
    background-color: #0f0f0f;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #333333;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #444444;
}

QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    border: none;
    background: none;
}

/* ===== CHECKBOX Y RADIO BUTTON ===== */
QCheckBox, QRadioButton {
    color: white;
    background-color: transparent;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid #0094C2;
}

QCheckBox::indicator:checked {
    background-color: #0094C2;
    border: 1px solid #0094C2;
}
