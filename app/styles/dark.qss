#Sidebar {
    background-color: #1e1e1e;
}

QPushButton#SidebarButton {
    background-color: #2a2a2a;
    color: #ffffff;

    font-size: 40px;
    font-weight: 850;

    border: none;
    border-radius: 6px;

    padding: 8px 14px;
    text-align: left;
}

QPushButton#SidebarButton:hover {
    background-color: #353535;
}

QPushButton#SidebarButton:pressed {
    background-color: #3f3f3f;
}
